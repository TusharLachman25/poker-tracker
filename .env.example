# Sharing config, baked into the build so nobody has to set anything up.
#
# Copy this file to `.env` and fill in the three values. `.env` is gitignored;
# for the deployed site these are set as GitHub repository secrets instead
# (Settings -> Secrets and variables -> Actions).
#
# Leave them empty and the app still works as a local-only tracker.

# Supabase -> Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Supabase -> Settings -> API -> anon public key. Safe to ship in a client app;
# the ledgers table is locked down and every call also needs the group code.
VITE_SUPABASE_ANON_KEY=

# The group code, e.g. K7QMPX-R4T9WBNZ2H. Create it once from the app
# (Settings -> Set up sharing -> Start a group), then paste it here so every
# later install joins that same group automatically.
VITE_GROUP_CODE=
